<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.stock.mapper.ErpStockRecordMapper">

    <resultMap type="ErpStockRecord" id="ErpStockRecordResult">
        <result property="recordId"     column="record_id"     />
        <result property="recordNo"     column="record_no"     />
        <result property="recordType"   column="record_type"   />
        <result property="direction"    column="direction"     />
        <result property="warehouseId"  column="warehouse_id"  />
        <result property="materialId"   column="material_id"   />
        <result property="quantity"     column="quantity"      />
        <result property="bizNo"        column="biz_no"        />
        <result property="operator"     column="operator"      />
        <result property="recordDate"   column="record_date"   />
        <result property="materialCode" column="material_code" />
        <result property="materialName" column="material_name" />
        <result property="warehouseName" column="warehouse_name" />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectErpStockRecordVo">
        select r.record_id, r.record_no, r.record_type, r.direction, r.warehouse_id,
               r.material_id, r.quantity, r.biz_no, r.operator, r.record_date,
               m.material_code, m.material_name, w.warehouse_name,
               r.create_by, r.create_time, r.update_by, r.update_time
        from erp_stock_record r
        left join erp_material m on m.material_id = r.material_id
        left join erp_warehouse w on w.warehouse_id = r.warehouse_id
    </sql>

    <select id="selectErpStockRecordList" parameterType="ErpStockRecord" resultMap="ErpStockRecordResult">
        <include refid="selectErpStockRecordVo"/>
        <where>
            <if test="recordType != null and recordType != ''"> and r.record_type = #{recordType}</if>
            <if test="direction != null and direction != ''"> and r.direction = #{direction}</if>
            <if test="warehouseId != null"> and r.warehouse_id = #{warehouseId}</if>
            <if test="materialId != null"> and r.material_id = #{materialId}</if>
            <if test="bizNo != null and bizNo != ''"> and r.biz_no = #{bizNo}</if>
            <if test="materialName != null and materialName != ''"> and m.material_name like concat('%', #{materialName}, '%')</if>
            <if test="warehouseName != null and warehouseName != ''"> and w.warehouse_name like concat('%', #{warehouseName}, '%')</if>
        </where>
        order by r.record_id desc
    </select>

    <select id="selectErpStockRecordById" parameterType="Long" resultMap="ErpStockRecordResult">
        <include refid="selectErpStockRecordVo"/>
        where r.record_id = #{recordId}
    </select>

    <insert id="insertErpStockRecord" parameterType="ErpStockRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into erp_stock_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recordNo != null">record_no,</if>
            <if test="recordType != null">record_type,</if>
            <if test="direction != null">direction,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="materialId != null">material_id,</if>
            <if test="quantity != null">quantity,</if>
            <if test="bizNo != null">biz_no,</if>
            <if test="operator != null">operator,</if>
            <if test="recordDate != null">record_date,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recordNo != null">#{recordNo},</if>
            <if test="recordType != null">#{recordType},</if>
            <if test="direction != null">#{direction},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="materialId != null">#{materialId},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="bizNo != null">#{bizNo},</if>
            <if test="operator != null">#{operator},</if>
            <if test="recordDate != null">#{recordDate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateErpStockRecord" parameterType="ErpStockRecord">
        update erp_stock_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="recordNo != null">record_no = #{recordNo},</if>
            <if test="recordType != null">record_type = #{recordType},</if>
            <if test="direction != null">direction = #{direction},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="materialId != null">material_id = #{materialId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="bizNo != null">biz_no = #{bizNo},</if>
            <if test="operator != null">operator = #{operator},</if>
            <if test="recordDate != null">record_date = #{recordDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteErpStockRecordById" parameterType="Long">
        delete from erp_stock_record where record_id = #{recordId}
    </delete>

</mapper>
