<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.purchase.mapper.ErpPurchaseOrderMapper">

    <resultMap type="ErpPurchaseOrder" id="ErpPurchaseOrderResult">
        <result property="orderId"      column="order_id"      />
        <result property="orderNo"      column="order_no"      />
        <result property="supplierId"   column="supplier_id"   />
        <result property="supplierName" column="supplier_name" />
        <result property="orderDate"    column="order_date"    />
        <result property="totalAmount"  column="total_amount"  />
        <result property="status"       column="status"       />
        <result property="remark"       column="remark"       />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectErpPurchaseOrderVo">
        select po.order_id, po.order_no, po.supplier_id, su.supplier_name, po.order_date,
               po.total_amount, po.status, po.remark, po.create_by, po.create_time,
               po.update_by, po.update_time
        from erp_purchase_order po
        left join erp_supplier su on su.supplier_id = po.supplier_id
    </sql>

    <select id="selectErpPurchaseOrderList" parameterType="ErpPurchaseOrder" resultMap="ErpPurchaseOrderResult">
        <include refid="selectErpPurchaseOrderVo"/>
        <where>
            <if test="orderNo != null and orderNo != ''"> and po.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="supplierName != null and supplierName != ''"> and su.supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="status != null and status != ''"> and po.status = #{status}</if>
        </where>
        order by po.order_id desc
    </select>

    <select id="selectErpPurchaseOrderById" parameterType="Long" resultMap="ErpPurchaseOrderResult">
        <include refid="selectErpPurchaseOrderVo"/>
        where po.order_id = #{orderId}
    </select>

    <insert id="insertErpPurchaseOrder" parameterType="ErpPurchaseOrder" useGeneratedKeys="true" keyProperty="orderId">
        insert into erp_purchase_order
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">order_no,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="orderDate != null">order_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">#{orderNo},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="orderDate != null">#{orderDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateErpPurchaseOrder" parameterType="ErpPurchaseOrder">
        update erp_purchase_order
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="orderDate != null">order_date = #{orderDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where order_id = #{orderId}
    </update>

    <delete id="deleteErpPurchaseOrderById" parameterType="Long">
        delete from erp_purchase_order where order_id = #{orderId}
    </delete>
</mapper>