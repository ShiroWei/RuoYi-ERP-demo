<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.sale.mapper.ErpSaleOutboundMapper">

    <resultMap type="ErpSaleOutbound" id="ErpSaleOutboundResult">
        <result property="outboundId"     column="outbound_id"     />
        <result property="outboundNo"     column="outbound_no"     />
        <result property="orderId"       column="order_id"       />
        <result property="orderNo"       column="order_no"       />
        <result property="customerId"    column="customer_id"    />
        <result property="customerName"  column="customer_name"  />
        <result property="warehouseId"   column="warehouse_id"   />
        <result property="warehouseName" column="warehouse_name" />
        <result property="outboundDate"   column="outbound_date"   />
        <result property="totalAmount"   column="total_amount"   />
        <result property="status"        column="status"        />
        <result property="remark"        column="remark"        />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectErpSaleOutboundVo">
        select pi.outbound_id, pi.outbound_no, pi.order_id, po.order_no, pi.customer_id,
               su.customer_name, pi.warehouse_id, wh.warehouse_name, pi.outbound_date,
               pi.total_amount, pi.status, pi.remark, pi.create_by, pi.create_time,
               pi.update_by, pi.update_time
        from erp_sale_outbound pi
        left join erp_sale_order po on po.order_id = pi.order_id
        left join erp_customer su on su.customer_id = pi.customer_id
        left join erp_warehouse wh on wh.warehouse_id = pi.warehouse_id
    </sql>

    <select id="selectErpSaleOutboundList" parameterType="ErpSaleOutbound" resultMap="ErpSaleOutboundResult">
        <include refid="selectErpSaleOutboundVo"/>
        <where>
            <if test="outboundNo != null and outboundNo != ''"> and pi.outbound_no like concat('%', #{outboundNo}, '%')</if>
            <if test="customerName != null and customerName != ''"> and su.customer_name like concat('%', #{customerName}, '%')</if>
            <if test="status != null and status != ''"> and pi.status = #{status}</if>
        </where>
        order by pi.outbound_id desc
    </select>

    <select id="selectErpSaleOutboundById" parameterType="Long" resultMap="ErpSaleOutboundResult">
        <include refid="selectErpSaleOutboundVo"/>
        where pi.outbound_id = #{outboundId}
    </select>

    <insert id="insertErpSaleOutbound" parameterType="ErpSaleOutbound" useGeneratedKeys="true" keyProperty="outboundId">
        insert into erp_sale_outbound
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="outboundNo != null">outbound_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="outboundDate != null">outbound_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="outboundNo != null">#{outboundNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="outboundDate != null">#{outboundDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateErpSaleOutbound" parameterType="ErpSaleOutbound">
        update erp_sale_outbound
        <trim prefix="SET" suffixOverrides=",">
            <if test="outboundNo != null">outbound_no = #{outboundNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="outboundDate != null">outbound_date = #{outboundDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where outbound_id = #{outboundId}
    </update>

    <delete id="deleteErpSaleOutboundById" parameterType="Long">
        delete from erp_sale_outbound where outbound_id = #{outboundId}
    </delete>
</mapper>
