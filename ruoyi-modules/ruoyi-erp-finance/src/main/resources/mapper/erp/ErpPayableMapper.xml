<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.finance.mapper.ErpPayableMapper">

    <resultMap type="ErpPayable" id="ErpPayableResult">
        <result property="payableId"    column="payable_id"    />
        <result property="billNo"       column="bill_no"       />
        <result property="billType"     column="bill_type"     />
        <result property="supplierId"   column="supplier_id"   />
        <result property="amount"       column="amount"        />
        <result property="paidAmount"   column="paid_amount"   />
        <result property="balance"      column="balance"       />
        <result property="dueDate"      column="due_date"      />
        <result property="status"       column="status"        />
        <result property="supplierName" column="supplier_name" />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
    </resultMap>

    <sql id="selectErpPayableVo">
        select p.payable_id, p.bill_no, p.bill_type, p.supplier_id, p.amount,
               p.paid_amount, p.balance, p.due_date, p.status,
               s.supplier_name,
               p.create_by, p.create_time, p.update_by, p.update_time
        from erp_payable p
        left join erp_supplier s on s.supplier_id = p.supplier_id
    </sql>

    <select id="selectErpPayableList" parameterType="ErpPayable" resultMap="ErpPayableResult">
        <include refid="selectErpPayableVo"/>
        <where>
            <if test="billNo != null and billNo != ''"> and p.bill_no = #{billNo}</if>
            <if test="billType != null and billType != ''"> and p.bill_type = #{billType}</if>
            <if test="supplierId != null"> and p.supplier_id = #{supplierId}</if>
            <if test="status != null and status != ''"> and p.status = #{status}</if>
            <if test="supplierName != null and supplierName != ''"> and s.supplier_name like concat('%', #{supplierName}, '%')</if>
        </where>
        order by p.payable_id desc
    </select>

    <select id="selectErpPayableById" parameterType="Long" resultMap="ErpPayableResult">
        <include refid="selectErpPayableVo"/>
        where p.payable_id = #{payableId}
    </select>

    <insert id="insertErpPayable" parameterType="ErpPayable" useGeneratedKeys="true" keyProperty="payableId">
        insert into erp_payable
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="billNo != null">bill_no,</if>
            <if test="billType != null">bill_type,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="amount != null">amount,</if>
            <if test="paidAmount != null">paid_amount,</if>
            <if test="balance != null">balance,</if>
            <if test="dueDate != null">due_date,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="billNo != null">#{billNo},</if>
            <if test="billType != null">#{billType},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="paidAmount != null">#{paidAmount},</if>
            <if test="balance != null">#{balance},</if>
            <if test="dueDate != null">#{dueDate},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateErpPayable" parameterType="ErpPayable">
        update erp_payable
        <trim prefix="SET" suffixOverrides=",">
            <if test="billNo != null">bill_no = #{billNo},</if>
            <if test="billType != null">bill_type = #{billType},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="paidAmount != null">paid_amount = #{paidAmount},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="dueDate != null">due_date = #{dueDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where payable_id = #{payableId}
    </update>

    <delete id="deleteErpPayableById" parameterType="Long">
        delete from erp_payable where payable_id = #{payableId}
    </delete>

</mapper>