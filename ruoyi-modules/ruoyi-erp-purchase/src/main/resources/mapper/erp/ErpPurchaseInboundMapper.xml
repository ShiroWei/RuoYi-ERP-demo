<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.erp.purchase.mapper.ErpPurchaseInboundMapper">

    <resultMap type="ErpPurchaseInbound" id="ErpPurchaseInboundResult">
        <result property="inboundId"     column="inbound_id"     />
        <result property="inboundNo"     column="inbound_no"     />
        <result property="orderId"       column="order_id"       />
        <result property="orderNo"       column="order_no"       />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"  column="supplier_name"  />
        <result property="warehouseId"   column="warehouse_id"   />
        <result property="warehouseName" column="warehouse_name" />
        <result property="inboundDate"   column="inbound_date"   />
        <result property="totalAmount"   column="total_amount"   />
        <result property="status"        column="status"        />
        <result property="remark"        column="remark"        />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectErpPurchaseInboundVo">
        select pi.inbound_id, pi.inbound_no, pi.order_id, po.order_no, pi.supplier_id,
               su.supplier_name, pi.warehouse_id, wh.warehouse_name, pi.inbound_date,
               pi.total_amount, pi.status, pi.remark, pi.create_by, pi.create_time,
               pi.update_by, pi.update_time
        from erp_purchase_inbound pi
        left join erp_purchase_order po on po.order_id = pi.order_id
        left join erp_supplier su on su.supplier_id = pi.supplier_id
        left join erp_warehouse wh on wh.warehouse_id = pi.warehouse_id
    </sql>

    <select id="selectErpPurchaseInboundList" parameterType="ErpPurchaseInbound" resultMap="ErpPurchaseInboundResult">
        <include refid="selectErpPurchaseInboundVo"/>
        <where>
            <if test="inboundNo != null and inboundNo != ''"> and pi.inbound_no like concat('%', #{inboundNo}, '%')</if>
            <if test="supplierName != null and supplierName != ''"> and su.supplier_name like concat('%', #{supplierName}, '%')</if>
            <if test="status != null and status != ''"> and pi.status = #{status}</if>
        </where>
        order by pi.inbound_id desc
    </select>

    <select id="selectErpPurchaseInboundById" parameterType="Long" resultMap="ErpPurchaseInboundResult">
        <include refid="selectErpPurchaseInboundVo"/>
        where pi.inbound_id = #{inboundId}
    </select>

    <insert id="insertErpPurchaseInbound" parameterType="ErpPurchaseInbound" useGeneratedKeys="true" keyProperty="inboundId">
        insert into erp_purchase_inbound
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="inboundNo != null">inbound_no,</if>
            <if test="orderId != null">order_id,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="inboundDate != null">inbound_date,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="inboundNo != null">#{inboundNo},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="inboundDate != null">#{inboundDate},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateErpPurchaseInbound" parameterType="ErpPurchaseInbound">
        update erp_purchase_inbound
        <trim prefix="SET" suffixOverrides=",">
            <if test="inboundNo != null">inbound_no = #{inboundNo},</if>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="inboundDate != null">inbound_date = #{inboundDate},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where inbound_id = #{inboundId}
    </update>

    <delete id="deleteErpPurchaseInboundById" parameterType="Long">
        delete from erp_purchase_inbound where inbound_id = #{inboundId}
    </delete>
</mapper>